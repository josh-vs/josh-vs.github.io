<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta content="width=device-width, initial-scale=1, shrink-to-fit=no" name="viewport"/>
    <link rel="icon" href="{{ './assets/favicon.ico' | url }}"/>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300..700;1,300..700&display=swap"
      rel="stylesheet">
    <style>
      {% set css %}
      {% include "assets/tailwind.css" %}
      {% endset %}
      s{{css | postcss | safe}}.max-w-8xl {
        max-width: 80rem;
      }
    </style>
    <title>{{ title }}</title>
  </head>
  <body class="container max-w-fit mx-2 md:mx-auto bg-blorp font-garamond antialiased">
    <section id="navbar">
      <nav class="sticky w-full top-0 right-0 flex flex-wrap ~py-1/3 bg-blorp shadow-md shadow-black">
        <div class="flex flex-auto justify-center md:justify-start items-center text-center ~ml-0/7 ">
          <p class="text-opacity-20 font-extralight animate-pulse">
            &lceil;</p>
          <a href="/" class="text-opacity-70 font-extralight block">
            Josh's WebPage
          </a>
          <p class="text-opacity-20 font-extralight block animate-pulse">
            &rfloor;</p>
        </div>
        <div class="flex flex-auto ~mr-0/7 justify-center md:justify-end">
          <p class="text-opacity-70 font-extralight block">
            <a href="{{ '/index#about' | url }}" class="text-opacity-70">About</a>
            |
            <a href="{{ '/index#projects' | url }}" class="text-opacity-70">Projects</a>
            |
            <a href="{{ '/index#gallery' | url }}" class="text-opacity-70">Gallery</a>
            |
            <a href="{{ '/index#sketch' | url }}" class="text-opacity-70">Sketchbook</a>
          </p>
        </div>
      </nav>
      <main>
        <section id="blog">
            <div class="tracking-wide ~space-y-5/7">{{ content | safe }}</div>
        </section>
      </main>
      <br/> <br/> <br/> <br/> <br/>
      <footer class="flex border-brap py-3 text-center">
        <div class="flex w-full flex-wrap place-items-center gap-x-20 gap-y-9">
          <p class=" ">© 2025 Joshua A. Lilleberg</p>
        </div>
        <div class="flex-wrap place-items-center gap-x-20 justify-end">
          <ul>
            <li><a href="mailto:daniel.von.stolzenberg@proton.me">Contact</a></li>
          </ul>
        </div>
      </footer>
    </body>
  </body>
</html>

---
layout: layout.njk
title: Home
tags: nav

---

<section id="about">
  <div class="text-center mt-5 mx-auto lg:max-w-screen-md md:max-w-screen-sm max-w-screen-sm rounded-s grid grid-cols-1 ~px-5/11 py-7 bg-tlorp place-items-center shadow-lg drop-shadow-xl shadow-black">
    <h1 class="pb-5">About</h1>
    <p class="text-justify">
      My name is Josh. I like to make things and learn stuff.
    </p>
  </div>
</section>

<section id="projects">
  <div class="text-center mx-auto lg:max-w-screen-md md:max-w-screen-sm max-w-screen-sm rounded-s grid grid-cols-1 ~px-5/11 py-7 bg-tlorp place-items-center shadow-lg drop-shadow-xl shadow-black">
    <h1 class="pb-5">Projects</h1>
    {% for post in collections.proj %}
    <p class="opacity-30 italic text-center">
      {{ post.data.date | fulldate }}:
    </p>
    <a href="{{ post.url }}" class="~mb-1/5">{{ post.data.title }}</a>
    {% endfor %}
  </div>
</section>

